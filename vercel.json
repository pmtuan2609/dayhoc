{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/(process_tikz\\.js|.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    {
      "src": "/admin(.*)",
      "dest": "/admin.php$1"
    },
    {
      "src": "/index(.*)",
      "dest": "/index.php$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
